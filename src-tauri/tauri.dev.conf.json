{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Hermes IDE Dev",
  "identifier": "com.hermes-ide.terminal.dev",
  "app": {
    "windows": [
      {
        "title": "HERMES-IDE · Dev",
        "width": 1200,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "createUpdaterArtifacts": false
  }
}
