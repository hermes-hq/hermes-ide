{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/hermes-hq/hermes-ide/src/catalog/agents.schema.json",
  "title": "Hermes agent catalog",
  "description": "Every agent Hermes knows how to start in a terminal. Validated by src/__tests__/agent-catalog.test.ts; read by the app (src/catalog/agentCatalog.ts, src-tauri/src/agent_catalog.rs) and by the nightly CLI drift check (scripts/agent-catalog-drift.mjs).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "agents"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/agent"
      }
    }
  },
  "definitions": {
    "placeholder": {
      "description": "Values Hermes fills in at launch.",
      "enum": [
        "{session_id}",
        "{prompt}",
        "{signals_file}",
        "{signals_dir}",
        "{hi}",
        "{port}",
        "{secret}"
      ]
    },
    "shellToken": {
      "description": "One argv item that is also safe to type into any shell unquoted (these are typed today; see ai_launch_command).",
      "type": "string",
      "pattern": "^([A-Za-z0-9@%+=:,./_-]+|\\{(session_id|prompt|signals_file|signals_dir|hi|port|secret)\\})$"
    },
    "execToken": {
      "description": "One argv item passed without a shell (exec form). No control characters.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "shellArgs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/shellToken"
      }
    },
    "shellArgsOrNull": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "minItems": 1,
          "allOf": [
            {
              "$ref": "#/definitions/shellArgs"
            }
          ],
          "type": "array"
        }
      ]
    },
    "binary": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": [
        {
          "$ref": "#/definitions/binary"
        }
      ],
      "additionalItems": {
        "$ref": "#/definitions/shellToken"
      }
    },
    "url": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "permissionMode": {
      "enum": [
        "default",
        "acceptEdits",
        "plan",
        "auto",
        "dontAsk",
        "bypassPermissions"
      ]
    },
    "status": {
      "enum": [
        "needs_approval",
        "needs_answer",
        "plan_ready",
        "working",
        "turn_end",
        "error",
        "exited",
        "session_start",
        "subagents",
        "limited",
        "tool_pending"
      ]
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "confidence"
      ],
      "properties": {
        "method": {
          "enum": [
            "settings_file",
            "config_flags",
            "env_file",
            "plugin_dir",
            "worktree_file",
            "event_stream",
            "none"
          ]
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/execToken"
          }
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/definitions/execToken"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]+$"
          }
        },
        "events": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/status"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "check_hook": {
          "description": "Done-When (F27): the hook event, in the per-launch settings file, whose command can refuse the agent's stop and feed failures back (exit code 2). Only for method settings_file.",
          "type": "string",
          "pattern": "^[A-Za-z]+$"
        },
        "hook_flags": {
          "description": "config_flags only: the events' hooks also go on the command line, in this shape (toml_config: -c hooks.<Event>=[...]).",
          "enum": [
            "toml_config"
          ]
        },
        "hook_trust": {
          "description": "How Hermes has the agent run exactly its own per-launch hooks without a review prompt (app_server_hooks_list: the hashes the agent's app server reports, passed as the launch's hook state). Never a blanket bypass: hooks anyone else configured keep their review.",
          "enum": [
            "app_server_hooks_list"
          ]
        },
        "confidence": {
          "enum": [
            "exact",
            "signal",
            "guessed"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "if": {
        "properties": {
          "method": {
            "const": "none"
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "confidence": {
            "const": "guessed"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "args"
              ],
              "type": "object"
            },
            {
              "required": [
                "env"
              ],
              "type": "object"
            },
            {
              "required": [
                "events"
              ],
              "type": "object"
            }
          ]
        },
        "type": "object"
      },
      "else": {
        "required": [
          "events"
        ],
        "type": "object"
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "resume",
        "new_session_id",
        "initial_prompt",
        "signals",
        "permission_flags",
        "min_version",
        "safety"
      ],
      "properties": {
        "argv": {
          "description": "The command that starts a new session. Every other argument list is appended to it.",
          "type": "array",
          "items": [
            {
              "$ref": "#/definitions/binary"
            }
          ],
          "additionalItems": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "resume": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "by_id",
            "latest"
          ],
          "properties": {
            "by_id": {
              "$ref": "#/definitions/shellArgsOrNull"
            },
            "latest": {
              "$ref": "#/definitions/shellArgsOrNull"
            },
            "not_found": {
              "description": "How the vendor says a resumed conversation does not exist. A resume that ends this way, within a few seconds, is replaced by a fresh start; any other early exit (Ctrl-C at a prompt, a crash) keeps the conversation. Without it a failed resume is never replaced.",
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "exit_codes": {
                  "description": "Exit codes the vendor uses for it. Empty or absent: any code except an interrupt.",
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 128
                  },
                  "uniqueItems": true
                },
                "output": {
                  "description": "Text the vendor prints for it (to the terminal, either stream); matched ignoring case, spaces and colours. One must appear.",
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 200
                  },
                  "uniqueItems": true
                }
              }
            }
          }
        },
        "new_session_id": {
          "$ref": "#/definitions/shellArgsOrNull"
        },
        "initial_prompt": {
          "$ref": "#/definitions/shellArgsOrNull"
        },
        "signals": {
          "$ref": "#/definitions/signals"
        },
        "permission_flags": {
          "type": "object",
          "required": [
            "default"
          ],
          "propertyNames": {
            "$ref": "#/definitions/permissionMode"
          },
          "properties": {
            "default": {
              "type": "array",
              "maxItems": 0
            }
          },
          "additionalProperties": {
            "minItems": 1,
            "allOf": [
              {
                "$ref": "#/definitions/shellArgs"
              }
            ],
            "type": "array"
          }
        },
        "beta_permission_modes": {
          "description": "Permission modes shown only with the agentCatalog flag on (2.0). Each must be a key of permission_flags; with the flag off the mode is not offered and a session asking for it starts in default.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/permissionMode",
            "not": {
              "const": "default"
            }
          }
        },
        "min_version": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
          ]
        },
        "safety": {
          "$ref": "#/definitions/safety"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "vendor",
        "description",
        "homepage",
        "status",
        "channel",
        "terminal",
        "install",
        "detect",
        "auth",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "vendor": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "homepage": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/url"
            }
          ]
        },
        "status": {
          "enum": [
            "current",
            "legacy"
          ]
        },
        "status_note": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "description": "stable: everyone sees it. beta: only with the agentCatalog feature flag.",
          "enum": [
            "stable",
            "beta"
          ]
        },
        "custom": {
          "const": true
        },
        "terminal": {
          "$ref": "#/definitions/terminal"
        },
        "structured": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol"
          ],
          "properties": {
            "protocol": {
              "enum": [
                "claude-agent-sdk",
                "codex-app-server",
                "acp"
              ]
            },
            "args": {
              "$ref": "#/definitions/shellArgs"
            }
          }
        },
        "install": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "command",
                "url"
              ],
              "properties": {
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "windows": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "$ref": "#/definitions/url"
                },
                "ci": {
                  "description": "Non-interactive variant the nightly CLI drift check runs, when the documented command asks questions.",
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "detect": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "command"
              ],
              "properties": {
                "command": {
                  "$ref": "#/definitions/command"
                }
              }
            }
          ]
        },
        "auth": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "check",
                "hint"
              ],
              "properties": {
                "check": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "#/definitions/command"
                    }
                  ]
                },
                "hint": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "evidence": {
          "description": "How the flags were checked: help = against the CLI's --help at this version; docs = vendor docs only; none = nothing to check.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level"
          ],
          "properties": {
            "level": {
              "enum": [
                "help",
                "docs",
                "none"
              ]
            },
            "version": {
              "type": "string"
            }
          }
        },
        "setup": {
          "description": "Where the agent reads its instruction files, settings, skills and MCP servers. Hermes only reads these (the instruction-file link writes one project file on request).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "instructions",
            "settings",
            "skills",
            "mcp"
          ],
          "properties": {
            "instructions": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "project",
                "global",
                "imports"
              ],
              "properties": {
                "project": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/setupPath"
                  }
                },
                "global": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/setupPath"
                  }
                },
                "imports": {
                  "description": "Whether the agent follows @path imports inside its instruction files.",
                  "type": "boolean"
                }
              }
            },
            "settings": {
              "$ref": "#/definitions/setupPaths"
            },
            "skills": {
              "$ref": "#/definitions/setupPaths"
            },
            "mcp": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "scope",
                      "format",
                      "key"
                    ],
                    "properties": {
                      "path": {
                        "$ref": "#/definitions/setupPath"
                      },
                      "scope": {
                        "enum": [
                          "project",
                          "global"
                        ]
                      },
                      "format": {
                        "enum": [
                          "json",
                          "toml",
                          "claude_local"
                        ]
                      },
                      "key": {
                        "type": "string",
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                      }
                    }
                  }
                }
              ]
            }
          }
        },
        "capabilities": {
          "$ref": "#/definitions/capabilities"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "legacy"
              }
            },
            "type": "object"
          },
          "then": {
            "required": [
              "status_note"
            ],
            "type": "object"
          }
        },
        {
          "if": {
            "required": [
              "custom"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "install": {
                "type": "null"
              },
              "detect": {
                "type": "null"
              },
              "auth": {
                "type": "null"
              },
              "terminal": {
                "properties": {
                  "argv": {
                    "maxItems": 0,
                    "type": "array"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          },
          "else": {
            "properties": {
              "install": {
                "type": "object"
              },
              "detect": {
                "type": "object"
              },
              "auth": {
                "type": "object"
              },
              "homepage": {
                "type": "string"
              },
              "vendor": {
                "type": "string"
              },
              "terminal": {
                "properties": {
                  "argv": {
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        }
      ]
    },
    "setupPath": {
      "description": "A file or folder an agent reads, relative to a project folder, or to the home folder when it starts with ~/. 'a|b' means the first that exists; '*' matches file names in one folder.",
      "type": "string",
      "pattern": "^(~/)?[A-Za-z0-9._*-][A-Za-z0-9._*/|~-]*$",
      "not": {
        "pattern": "(^|/)\\.\\.(/|$)"
      }
    },
    "setupPaths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "global"
      ],
      "properties": {
        "project": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/setupPath"
          }
        },
        "global": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/setupPath"
          }
        }
      }
    },
    "safety": {
      "description": "Hermes's one safety default (write inside the working folder; ask for network and outside paths), mapped to this agent's launch flags. default_mode names one of permission_flags; fit says how close that mode comes to the default; looser_args are argument sequences that run the agent looser than the default.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_mode",
        "fit",
        "looser_args",
        "note"
      ],
      "properties": {
        "default_mode": {
          "$ref": "#/definitions/permissionMode"
        },
        "fit": {
          "enum": [
            "exact",
            "closest",
            "stricter",
            "looser",
            "unknown"
          ]
        },
        "looser_args": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/shellToken"
            }
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capabilities": {
      "description": "What a person can choose at launch (2.0 launch contract; see src/agent/capabilities and src-tauri/src/agent_caps). Read by the backend; facts from the verified capability matrix.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verified_on_real_install",
        "model",
        "effort",
        "accounts",
        "error_signatures",
        "model_report"
      ],
      "properties": {
        "verified_on_real_install": {
          "description": "True only for agents proven with a real CLI in this release.",
          "type": "boolean"
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "flag",
            "id_style",
            "aliases",
            "list",
            "typed"
          ],
          "properties": {
            "flag": {
              "description": "Arguments that pick the model; {model} is filled in. Omitted for the default model.",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/definitions/execToken"
                  }
                }
              ]
            },
            "id_style": {
              "enum": [
                "alias",
                "slug",
                "display",
                "provider/model"
              ]
            },
            "aliases": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "label"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._:/\\[\\]-]+$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "note": {
                    "type": "string"
                  }
                }
              }
            },
            "list": {
              "description": "Where the model list comes from: a read-only command and its parser, a local cache, or null (aliases / type a name).",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "command",
                    "parser"
                  ],
                  "properties": {
                    "command": {
                      "type": "array",
                      "minItems": 1,
                      "items": [
                        {
                          "$ref": "#/definitions/binary"
                        }
                      ],
                      "additionalItems": {
                        "$ref": "#/definitions/execToken"
                      }
                    },
                    "parser": {
                      "enum": [
                        "codex_debug_models",
                        "agy_models",
                        "lines"
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source"
                  ],
                  "properties": {
                    "source": {
                      "enum": [
                        "claude_model_cache"
                      ]
                    }
                  }
                }
              ]
            },
            "typed": {
              "description": "A model name that is not listed may be typed.",
              "type": "boolean"
            },
            "silent_fallback": {
              "description": "The CLI runs another model without a word when given one it does not know (Antigravity 1.2 in its interactive mode), so Hermes never launches a model its list does not have.",
              "type": "boolean"
            }
          }
        },
        "effort": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "flag",
                "values",
                "per_model",
                "validated_by"
              ],
              "properties": {
                "flag": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "$ref": "#/definitions/execToken"
                      }
                    }
                  ]
                },
                "env": {
                  "description": "An environment variable that sets the effort (when there is no flag).",
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]*$"
                },
                "values": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z]+$"
                  }
                },
                "per_model": {
                  "description": "First match wins (a regular expression on the model id); unmatched models take every value.",
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "match",
                          "values"
                        ],
                        "properties": {
                          "match": {
                            "type": "string",
                            "minLength": 1
                          },
                          "values": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "pattern": "^[a-z]+$"
                            }
                          }
                        }
                      }
                    }
                  ]
                },
                "validated_by": {
                  "enum": [
                    "cli",
                    "server",
                    "none"
                  ]
                }
              }
            }
          ]
        },
        "accounts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "probe",
            "profile_env",
            "profile_dir",
            "login"
          ],
          "properties": {
            "probe": {
              "description": "A read-only command that tells whether the CLI is signed in.",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "command",
                    "parser"
                  ],
                  "properties": {
                    "command": {
                      "type": "array",
                      "minItems": 1,
                      "items": [
                        {
                          "$ref": "#/definitions/binary"
                        }
                      ],
                      "additionalItems": {
                        "$ref": "#/definitions/execToken"
                      }
                    },
                    "parser": {
                      "enum": [
                        "claude_auth_json",
                        "codex_login_status",
                        "agy_models",
                        "exit_code"
                      ]
                    }
                  }
                }
              ]
            },
            "profile_env": {
              "description": "The environment variable that points the CLI at another profile folder, or null (one account per computer user).",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]*$"
                }
              ]
            },
            "profile_dir": {
              "description": "The profile folder Hermes creates under the home folder on Add account ({slug} = the account's name).",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^\\.[a-z0-9-]+\\{slug\\}$"
                }
              ]
            },
            "login": {
              "description": "The CLI's own sign-in command, run in a terminal with the profile's environment.",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": [
                    {
                      "$ref": "#/definitions/binary"
                    }
                  ],
                  "additionalItems": {
                    "$ref": "#/definitions/execToken"
                  }
                }
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "error_signatures": {
          "description": "How the CLI says it refused a launch (regular expressions on its output lines; ^ = the start of a line).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pattern",
              "reason",
              "suggestion"
            ],
            "properties": {
              "pattern": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "enum": [
                  "model",
                  "effort",
                  "signed_out",
                  "other"
                ]
              },
              "suggestion": {
                "enum": [
                  "retry-default",
                  "switch-account",
                  "sign-in"
                ]
              }
            }
          }
        },
        "model_report": {
          "description": "Where the agent reports the model it runs (for the session's model chip).",
          "enum": [
            "stream_init",
            "hooks:model",
            "hooks:modelName",
            "rollout",
            "history_md",
            "none"
          ]
        }
      }
    }
  }
}
