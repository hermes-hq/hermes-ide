{
  "$schema": "./agents.schema.json",
  "version": 1,
  "agents": [
    {
      "id": "claude",
      "name": "Claude Code",
      "vendor": "Anthropic",
      "description": "Anthropic's coding agent",
      "homepage": "https://code.claude.com/docs/en/setup",
      "status": "current",
      "channel": "stable",
      "terminal": {
        "argv": ["claude"],
        "resume": {
          "by_id": ["--resume", "{session_id}"],
          "latest": ["--continue"],
          "not_found": { "exit_codes": [1], "output": ["No conversation found with session ID"] }
        },
        "new_session_id": ["--session-id", "{session_id}"],
        "initial_prompt": ["{prompt}"],
        "signals": {
          "method": "settings_file",
          "args": ["--settings", "{signals_file}"],
          "events": {
            "session_start": ["SessionStart"],
            "working": ["UserPromptSubmit", "PostToolUse", "PostToolUseFailure", "PermissionDenied"],
            "needs_approval": ["PermissionRequest"],
            "needs_answer": ["PreToolUse:AskUserQuestion", "Notification:elicitation_dialog"],
            "plan_ready": ["PreToolUse:ExitPlanMode"],
            "turn_end": ["Stop"],
            "error": ["StopFailure"],
            "exited": ["SessionEnd"],
            "subagents": ["SubagentStart", "SubagentStop"],
            "limited": [
              "StopFailure:rate_limit",
              "Notification:quota_auto_resume_stale",
              "Notification:quota_auto_resume_disabled",
              "Notification:quota_auto_resume_fired",
              "UserPromptSubmit",
              "statusLine:rate_limits"
            ]
          },
          "check_hook": "Stop",
          "confidence": "exact",
          "note": "Hook entries merge with the user's own hooks; nothing is written to the user's settings. 'limited' lists the events that start, update or end a usage limit; the status line (which carries rate_limits) is set only when the user has none of their own."
        },
        "permission_flags": {
          "default": [],
          "acceptEdits": ["--permission-mode", "acceptEdits"],
          "plan": ["--permission-mode", "plan"],
          "auto": ["--permission-mode", "auto"],
          "dontAsk": ["--permission-mode", "dontAsk"],
          "bypassPermissions": ["--permission-mode", "bypassPermissions"]
        },
        "min_version": "2.1.0",
        "safety": {
          "default_mode": "acceptEdits",
          "fit": "exact",
          "looser_args": [["--dangerously-skip-permissions"], ["--permission-mode", "bypassPermissions"], ["--permission-mode", "auto"]],
          "note": "Edits inside the working folder are accepted; commands, web access and other folders ask."
        }
      },
      "structured": { "protocol": "claude-agent-sdk" },
      "install": {
        "command": "curl -fsSL https://claude.ai/install.sh | bash",
        "windows": "irm https://claude.ai/install.ps1 | iex",
        "url": "https://code.claude.com/docs/en/setup"
      },
      "detect": { "command": ["claude", "--version"] },
      "auth": { "check": ["claude", "auth", "status"], "hint": "Run 'claude' and sign in on first use" },
      "evidence": { "level": "help", "version": "2.1.283" },
      "setup": {
        "instructions": { "project": ["CLAUDE.md", ".claude/CLAUDE.md", "CLAUDE.local.md"], "global": ["~/.claude/CLAUDE.md"], "imports": true },
        "settings": { "project": [".claude/settings.json", ".claude/settings.local.json"], "global": ["~/.claude/settings.json"] },
        "skills": { "project": [".claude/skills"], "global": ["~/.claude/skills"] },
        "mcp": [{ "path": ".mcp.json", "scope": "project", "format": "json", "key": "mcpServers" }, { "path": "~/.claude.json", "scope": "global", "format": "json", "key": "mcpServers" }, { "path": "~/.claude.json", "scope": "global", "format": "claude_local", "key": "mcpServers" }]
      }
    },
    {
      "id": "codex",
      "name": "Codex",
      "vendor": "OpenAI",
      "description": "OpenAI's coding agent",
      "homepage": "https://github.com/openai/codex",
      "status": "current",
      "channel": "stable",
      "terminal": {
        "argv": ["codex"],
        "resume": {
          "by_id": ["resume", "{session_id}"],
          "latest": ["resume", "--last"],
          "not_found": { "output": ["No saved session found with ID"] }
        },
        "new_session_id": null,
        "initial_prompt": ["{prompt}"],
        "signals": {
          "method": "config_flags",
          "args": [
            "-c", "tui.notifications=true",
            "-c", "tui.notification_method=\"osc9\"",
            "-c", "tui.notification_condition=\"always\"",
            "-c", "notify=[\"{hi}\",\"signal\",\"--agent\",\"codex\",\"--argv-json\"]"
          ],
          "events": {
            "session_start": ["SessionStart"],
            "working": ["UserPromptSubmit", "PostToolUse"],
            "needs_approval": ["PermissionRequest", "osc9:Approval requested"],
            "needs_answer": ["osc9:Question requested"],
            "turn_end": ["notify:agent-turn-complete", "Stop"],
            "exited": ["SessionEnd"]
          },
          "confidence": "exact",
          "note": "No flag assigns a session id up front; it is read from the hook session_id or the notify thread-id."
        },
        "permission_flags": {
          "default": [],
          "auto": ["--sandbox", "workspace-write", "--ask-for-approval", "on-request"],
          "bypassPermissions": ["--dangerously-bypass-approvals-and-sandbox"]
        },
        "min_version": "0.145.0",
        "safety": {
          "default_mode": "auto",
          "fit": "exact",
          "looser_args": [["--dangerously-bypass-approvals-and-sandbox"], ["--yolo"], ["--sandbox", "danger-full-access"], ["-s", "danger-full-access"], ["--ask-for-approval", "never"], ["-a", "never"]],
          "note": "Writes inside the workspace; the network is off and anything outside it asks."
        }
      },
      "structured": { "protocol": "codex-app-server", "args": ["app-server"] },
      "install": {
        "command": "npm install -g @openai/codex",
        "url": "https://github.com/openai/codex"
      },
      "detect": { "command": ["codex", "--version"] },
      "auth": { "check": ["codex", "login", "status"], "hint": "Run 'codex' and sign in on first use" },
      "evidence": { "level": "help", "version": "0.145.0" },
      "setup": {
        "instructions": { "project": ["AGENTS.override.md|AGENTS.md"], "global": ["~/.codex/AGENTS.override.md|~/.codex/AGENTS.md"], "imports": false },
        "settings": { "project": [".codex/config.toml"], "global": ["~/.codex/config.toml"] },
        "skills": { "project": [".agents/skills"], "global": ["~/.agents/skills", "~/.codex/skills"] },
        "mcp": [{ "path": ".codex/config.toml", "scope": "project", "format": "toml", "key": "mcp_servers" }, { "path": "~/.codex/config.toml", "scope": "global", "format": "toml", "key": "mcp_servers" }]
      }
    },
    {
      "id": "antigravity",
      "name": "Antigravity CLI",
      "vendor": "Google",
      "description": "Google's coding agent (agy)",
      "homepage": "https://antigravity.google/docs/cli/install/",
      "status": "current",
      "channel": "beta",
      "terminal": {
        "argv": ["agy"],
        "resume": { "by_id": ["--conversation", "{session_id}"], "latest": ["--continue"] },
        "new_session_id": null,
        "initial_prompt": ["--prompt-interactive", "{prompt}"],
        "signals": {
          "method": "worktree_file",
          "files": [".agents/hooks.json"],
          "events": {
            "working": ["PreToolUse", "PostToolUse"],
            "turn_end": ["Stop:fullyIdle"],
            "error": ["Stop:error"]
          },
          "confidence": "exact",
          "note": "No per-launch flag exists; the hook file goes into the Hermes-owned worktree and is excluded from git. There is no approval event, so approvals stay guessed."
        },
        "permission_flags": {
          "default": [],
          "bypassPermissions": ["--dangerously-skip-permissions"]
        },
        "min_version": "1.0.6",
        "safety": {
          "default_mode": "default",
          "fit": "stricter",
          "looser_args": [["--dangerously-skip-permissions"]],
          "note": "No launch flag accepts edits only, so the agent asks before every change."
        }
      },
      "install": {
        "command": "curl -fsSL https://antigravity.google/cli/install.sh | bash",
        "windows": "irm https://antigravity.google/cli/install.ps1 | iex",
        "url": "https://antigravity.google/docs/cli/install/"
      },
      "detect": { "command": ["agy", "--version"] },
      "auth": { "check": null, "hint": "Run 'agy' and sign in with Google in the browser, or set GEMINI_API_KEY" },
      "evidence": { "level": "help", "version": "1.0.6" },
      "setup": {
        "instructions": { "project": ["AGENTS.md", "GEMINI.md"], "global": ["~/.gemini/GEMINI.md"], "imports": false },
        "settings": { "project": [".agents/hooks.json"], "global": [] },
        "skills": { "project": [".agents/skills"], "global": [] },
        "mcp": null
      }
    },
    {
      "id": "gemini",
      "name": "Gemini CLI (legacy)",
      "vendor": "Google",
      "description": "Google's previous coding agent",
      "homepage": "https://github.com/google-gemini/gemini-cli",
      "status": "legacy",
      "status_note": "Retired for personal Google accounts on 2026-06-18; still works with a paid API key or Gemini Code Assist Standard or Enterprise. Antigravity CLI is Google's current agent.",
      "channel": "stable",
      "terminal": {
        "argv": ["gemini"],
        "resume": {
          "by_id": ["--resume", "{session_id}"],
          "latest": ["--resume", "latest"],
          "not_found": { "exit_codes": [42], "output": ["Error resuming session"] }
        },
        "new_session_id": ["--session-id", "{session_id}"],
        "initial_prompt": ["{prompt}"],
        "signals": {
          "method": "env_file",
          "env": { "GEMINI_CLI_SYSTEM_DEFAULTS_PATH": "{signals_file}" },
          "events": {
            "working": ["BeforeAgent"],
            "needs_approval": ["Notification:ToolPermission"],
            "turn_end": ["AfterAgent"],
            "exited": ["SessionEnd"]
          },
          "confidence": "exact",
          "note": "The lowest-precedence settings layer; hook arrays merge with the user's own."
        },
        "permission_flags": {
          "default": [],
          "acceptEdits": ["--approval-mode", "auto_edit"],
          "plan": ["--approval-mode", "plan"],
          "bypassPermissions": ["--yolo"]
        },
        "min_version": "0.45.0",
        "safety": {
          "default_mode": "acceptEdits",
          "fit": "exact",
          "looser_args": [["--yolo"], ["-y"], ["--approval-mode", "yolo"]],
          "note": "Edits are accepted; commands and web access ask."
        }
      },
      "structured": { "protocol": "acp", "args": ["--acp"] },
      "install": {
        "command": "npm install -g @google/gemini-cli",
        "url": "https://github.com/google-gemini/gemini-cli"
      },
      "detect": { "command": ["gemini", "--version"] },
      "auth": { "check": null, "hint": "Needs GEMINI_API_KEY or a Gemini Code Assist Standard or Enterprise login" },
      "evidence": { "level": "help", "version": "0.45.2" },
      "setup": {
        "instructions": { "project": ["GEMINI.md"], "global": ["~/.gemini/GEMINI.md"], "imports": true },
        "settings": { "project": [".gemini/settings.json"], "global": ["~/.gemini/settings.json"] },
        "skills": { "project": [".gemini/skills"], "global": ["~/.gemini/skills"] },
        "mcp": [{ "path": ".gemini/settings.json", "scope": "project", "format": "json", "key": "mcpServers" }, { "path": "~/.gemini/settings.json", "scope": "global", "format": "json", "key": "mcpServers" }]
      }
    },
    {
      "id": "copilot",
      "name": "GitHub Copilot CLI",
      "vendor": "GitHub",
      "description": "GitHub's coding agent",
      "homepage": "https://github.com/github/copilot-cli",
      "status": "current",
      "channel": "stable",
      "terminal": {
        "argv": ["copilot"],
        "resume": { "by_id": ["--resume", "{session_id}"], "latest": ["--continue"] },
        "new_session_id": ["--session-id", "{session_id}"],
        "initial_prompt": ["--interactive", "{prompt}"],
        "signals": {
          "method": "plugin_dir",
          "args": ["--plugin-dir", "{signals_dir}"],
          "events": {
            "session_start": ["sessionStart"],
            "exited": ["sessionEnd"],
            "needs_approval": ["notification:permission_prompt"],
            "needs_answer": ["notification:elicitation_dialog"],
            "turn_end": ["agentStop"],
            "error": ["errorOccurred"]
          },
          "confidence": "signal",
          "note": "notification can fire for tools that are already approved (github/copilot-cli#2586), so approval is not exact."
        },
        "permission_flags": {
          "default": [],
          "acceptEdits": ["--allow-tool", "write"],
          "plan": ["--plan"],
          "auto": ["--allow-all-tools"],
          "bypassPermissions": ["--allow-all"]
        },
        "beta_permission_modes": ["acceptEdits"],
        "min_version": "1.0.0",
        "safety": {
          "default_mode": "acceptEdits",
          "fit": "exact",
          "looser_args": [["--allow-all"], ["--allow-all-tools"], ["--allow-all-paths"], ["--allow-all-urls"], ["--yolo"]],
          "note": "File edits are allowed; commands, URLs and paths outside the folder ask."
        }
      },
      "structured": { "protocol": "acp", "args": ["--acp"] },
      "install": {
        "command": "npm install -g @github/copilot",
        "url": "https://github.com/github/copilot-cli"
      },
      "detect": { "command": ["copilot", "--version"] },
      "auth": { "check": null, "hint": "Run 'copilot' and use /login, or set GH_TOKEN" },
      "evidence": { "level": "help", "version": "1.0.88" },
      "setup": {
        "instructions": { "project": [".github/copilot-instructions.md", "AGENTS.md", "CLAUDE.md", "GEMINI.md", ".github/instructions/*.instructions.md"], "global": ["~/.copilot/copilot-instructions.md"], "imports": false },
        "settings": { "project": [], "global": ["~/.copilot/config.json"] },
        "skills": { "project": [".github/skills", ".claude/skills"], "global": ["~/.copilot/skills"] },
        "mcp": [{ "path": "~/.copilot/mcp-config.json", "scope": "global", "format": "json", "key": "mcpServers" }]
      }
    },
    {
      "id": "opencode",
      "name": "OpenCode",
      "vendor": "SST",
      "description": "Open-source coding agent for any model",
      "homepage": "https://opencode.ai/docs/cli/",
      "status": "current",
