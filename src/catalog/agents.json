        "min_version": "1.18.0",
        "safety": {
          "default_mode": "default",
          "fit": "looser",
          "looser_args": [["--auto"]],
          "note": "OpenCode runs tools without asking by default and has no launch flag that narrows it."
        }
      },
      "structured": { "protocol": "acp", "args": ["acp"] },
      "install": {
        "command": "npm install -g opencode-ai",
        "url": "https://opencode.ai/docs/"
      },
      "detect": { "command": ["opencode", "--version"] },
      "auth": { "check": ["opencode", "providers", "list"], "hint": "Run 'opencode providers login' to add a model provider" },
      "evidence": { "level": "help", "version": "1.18.32" },
      "setup": {
        "instructions": { "project": ["AGENTS.md|CLAUDE.md"], "global": ["~/.config/opencode/AGENTS.md|~/.claude/CLAUDE.md"], "imports": false },
