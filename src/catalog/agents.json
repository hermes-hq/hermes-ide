        "skills": { "project": [".opencode/skills", ".claude/skills", ".agents/skills"], "global": ["~/.config/opencode/skills"] },
        "mcp": [{ "path": "opencode.json", "scope": "project", "format": "json", "key": "mcp" }, { "path": "~/.config/opencode/opencode.json", "scope": "global", "format": "json", "key": "mcp" }]
      }
